APP_NAME="OrbiTouch ATS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE="Asia/Kolkata"
APP_URL=https://crm.orbitouch-hr.com
APP_CURRENCY="INR"
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# Production uses MySQL / MariaDB on Hostinger
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u000000000_orbitouch_ats
DB_USERNAME=u000000000_ats_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=orbitouch_ats_

# SMTP Email Configuration (Hostinger Titan / Custom SMTP)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=crm@orbitouch-hr.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="crm@orbitouch-hr.com"
MAIL_FROM_NAME="${APP_NAME}"

# OrbiTouch ATS Enterprise Security & Hosting Controls
ATS_REQUIRE_SUPER_ADMIN_2FA=true
ATS_MAX_STORAGE_BYTES=18253611008
ATS_STORAGE_WARN_70=70
ATS_STORAGE_WARN_85=85
ATS_STORAGE_WARN_95=95
ATS_MAX_UPLOAD_KB=10240

# External Backup Destination Configuration (S3 / SFTP / External Vault)
ATS_BACKUP_ENABLED=true
ATS_BACKUP_EXTERNAL_DISK=
ATS_BACKUP_ENCRYPTION_KEY=
ATS_BACKUP_RETENTION_DAYS=30

# Optional Future Integrations (Disabled by default)
ATS_GOOGLE_CALENDAR_ENABLED=false
ATS_GMAIL_SYNC_ENABLED=false
ATS_WHATSAPP_BUSINESS_ENABLED=false
ATS_CLOUD_TELEPHONY_ENABLED=false

# Optional S3-Compatible Document Vault (Future Expansion)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
